{
    "id" : "page.codeberg.grinka.Transition",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "transition",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-music",
        "--filesystem=xdg-videos",
        "--filesystem=xdg-download"
    ],
    "modules" : [
        {
            "name" : "Transition",
            "buildsystem" : "meson",
            "config-opts": [
                "-Dprofile=release"
            ],
            "build-options" : {
                "append-path" : "/usr/lib/sdk/rust-stable/bin",
                "env" : {
                    "CARGO_NET_OFFLINE": "true"
                }
            },
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://codeberg.org/grinka/transition.git",
                    "tag": "v3.0",
					"commit": "88675b17e6255e48c610a2f347b75e95525f3b7a"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir -p .cargo",
                        "cp -vf cargo/config .cargo/config.toml"
                    ]
                }
            ]
        }
    ]
}
